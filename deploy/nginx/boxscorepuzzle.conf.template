# The server block. **E3, built 2026-08-24, and it runs on the laptop only.**
#
# ⚠️⚠️ **This file is NOT under `serve/`, and that is not tidiness.** `serve/` is the served root: a
# configuration file inside it is a configuration file nginx hands to anyone who asks for it. The same
# argument keeps `tools/dev_server.py` out of `serve/` and `forge/` off the VPS -- the boundary is what
# the directory *means*.
#
# ⚠️ **And not in `publish/` either.** That tree is *the serving side's executables*, and its own
# creation note records the trap: a sentence that stays true by wording while changing in substance is
# worse than one that visibly needs rewriting. A config is not an executable. `deploy/` is a sibling
# holding what the VPS needs and cannot run.
#
# ⚠️⚠️ **This is a TEMPLATE, not a finished config**, and the extension says so. It carries
# `${KEEP_SHARED_TOKEN}`; the nginx image substitutes it at container start from `/etc/nginx/templates/`.
# **The token is therefore never in the image and there is no default** — `docs/signing-keys.md`'s
# precedent: a key file is where the key is, an exported variable is an instruction, and a default is
# what reaches production by omission.
#
# ⚠️ `NGINX_ENVSUBST_FILTER=^KEEP_` keeps the substitution to that one name, so nginx's own `$host`,
# `$1` and `$keep_upstream` survive it untouched.
#
# ⚠⚠ **Two things are declared elsewhere and this file must not restate either.**
#
#   * the routes -- `tools/dev_server.py`'s `ROUTES`, tagged production or development
#   * the cache rule per document -- the table in `docs/calendar.md`
#
# `forge/tests/test_nginx_serves_what_is_declared.py` starts this config over `serve/` and checks every
# row of both. **It asserts both halves of the route tag**: everything tagged production answers, and
# **nothing tagged development does** -- an nginx that also served `/t/<mode>` would hand players
# `?test=solved`, which is what tagging exists to prevent.
#
# ⚠️⚠️ **Half of what this file will do cannot be tested here, and it is named rather than discovered at
# deployment.** `docs/beta-0-plan.md` E3 splits it. Not testable on a laptop: TLS and certbot, DNS, the
# `/api/events`, `/api/errors` and `/api/shares` proxy to `keep` with the shared token, `keep` being reachable only on
# the internal network, and IPs not being persisted anywhere -- `access_log off` is checkable and the
# host property is not. **Those lines are absent from this file** rather than present and unverified:
# an untested line that looks finished is worse than a gap F has to fill deliberately.

server {
    listen 8080;
    server_name localhost;

    root /srv/serve;
    index index.html;

    # ⚠️ **No `access_log off` yet, and no rate limit.** Both are E3 by the plan and both are
    # host-shaped: what `access_log off` buys is *IPs are not persisted*, which is a property of the
    # machine and not of this file, and a rate limit tuned against a laptop is a number with no
    # measurement behind it (§7). F sets them where the evidence is.

    # ---- the routes, from `ROUTES` ------------------------------------------------------------
    # ⚠️⚠️ **`/` is a 200 by rewrite, not a redirect.** v36-P3-48: a redirect makes the canonical
    # homepage a second URL. Every visit lands here (`docs/serve-flow.md` §1).
    location = / {
        # ⚠️ `no-store` like every other page: `docs/calendar.md`'s table puts `/`, `/p/<id>` and the
        # modules together, because they are the application and a stale copy has twice refuted a
        # change that was correct.
        add_header Cache-Control "no-store" always;
        try_files /ui/phone/index.html =404;
    }

    # ⚠️ C6 still holds -- `/today` redirects -- and since E1 the redirect is the *page's*, not the
    # server's: §23 forbids a process on the play path, so this answers 200 with a page that reads
    # `today.json` and replaces itself.
    location = /today {
        add_header Cache-Control "no-store" always;
        try_files /ui/phone/today.html =404;
    }

    # ⚠️⚠️ **Anchored to hex, and a bare prefix was a blank page.** `location ^~ /p/` would answer
    # `/p/main.js` with the board page, so the browser gets HTML where it asked for a module and refuses
    # it on MIME. The pages name their assets absolutely now and this matches only an opaque id -- the
    # same pattern `daily.js`'s `idInPath` uses.
    location ~ "^/p/[0-9a-f]+/?$" {
        add_header Cache-Control "no-store" always;
        try_files /ui/phone/play.html =404;
    }

    # ⚠️ The tutorial, which had no URL until 2026-08-24 while `docs/serve-flow.md` §1b said it was
    # reachable from the landing page at any time. The landing linked `tutorial.html`, a filename.
    location = /tutorial {
        add_header Cache-Control "no-store" always;
        try_files /ui/phone/tutorial.html =404;
    }

    # ---- the cache rule, from `docs/calendar.md` --------------------------------------------------
    # ⚠️⚠️ **The enforcement is the absent id; this is the belt.** Only two ids are public, so tomorrow's
    # puzzle cannot be requested by anyone who cannot name it and no intermediary can prefetch a URL it
    # cannot construct. Written in this order deliberately: the other way round, the header reads as the
    # thing holding the line and the next person to meet a slow first load relaxes it.
    #
    # The dated pointers change daily. **A stale pointer is indistinguishable from a rotation that did
    # not run.**
    location ~ "^/data/puzzles/(today|yesterday)\.json$" {
        add_header Cache-Control "no-store" always;
    }

    # The public manifest is written from the files actually placed, so it moves with them.
    location = /data/puzzles/manifest.json {
        add_header Cache-Control "no-store" always;
    }

    # ⚠️ A package cannot change: a different board gets a different id. This is the one thing here that
    # caches, and it caches hard.
    location ~ "^/data/puzzles/[0-9a-f]+\.json$" {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # ⚠️ The application. A stale copy has twice refuted a change that was correct here
    # (`docs/serve-brief.md` §7), which is why this is `no-store` rather than a revalidation window.
    location /ui/ {
        add_header Cache-Control "no-store" always;
    }

    # ⚠️⚠️ **`/engine/` is application code and was outside the rule.** The pages import the engine as
    # `../../engine/package.js`, which resolves to **`/engine/package.js`** — a path with no cache block,
    # so it took nginx's default. A deploy could serve a new `main.js` beside a cached `game.js`, which
    # is the mixed-version failure `no-store` was adopted for after stale JavaScript made a correct
    # schema change look broken twice.
    #
    # ⚠️ **The cache table's test could not see it**, because the table said *the modules and the CSS*
    # and listed only a `/ui/` URL. It lists an engine module now, so the sweep requests one. v41-P2-02.
    location /engine/ {
        add_header Cache-Control "no-store" always;
    }

    # ---- the data layer, reached only through here (F1.3b) ----------------------------------------
    # ⚠⚠⚠ **The browser must never reach `keep`.** Its port is not published and the shared token must
    # not travel to a browser (`docs/data-layer.md` §4), so the client posts here and **the token is
    # added at the edge**, where the secret already lives and the browser cannot see it.
    #
    # ⚠⚠ **`${KEEP_SHARED_TOKEN}` comes from the environment at run time and is never in the image.** The
    # precedent is `docs/signing-keys.md`: *a key file is where the key is; an exported variable is an
    # instruction.* There is no default here on purpose — a default is what reaches production by
    # omission, and a token file in the tree is something somebody copies.
    #
    # ⚠️ **Until this block is deployed the two paths 404, and that is by design.** A 404 leaves the
    # client's queue intact, so every event and error recorded before deployment is delivered by the
    # first visit after it. Dropping them would be permanent (C7).
    # ⚠️⚠️ **Three routes, anchored, and the list is a list rather than a prefix.** `location /api/`
    # would forward anything under it to `keep`, including paths `keep` does not serve and paths added
    # to it later without anybody deciding they should be public. Naming the three is what makes adding
    # a fourth a decision.
    #
    # ⚠️ `shares` arrived with the share (G). It is a separate route because a share is a separate
    # event: it happens after the game is uploaded, and `keep`'s insert ignores a second arrival of an
    # id it already holds — so a `shared` field on the event could never be filled in afterwards.
    location ~ "^/api/(events|errors|shares)$" {
        # ⚠️ Only POST reaches `keep`. Anything else is refused here rather than forwarded: the data
        # layer answers three routes and a GET on this path is not one of them.
        limit_except POST { deny all; }

        # ⚠⚠ **The client's own Authorization header is discarded, not merged.** A browser that sent one
        # must not be able to influence what `keep` sees; the edge decides, every time.
        proxy_set_header Authorization "Bearer ${KEEP_SHARED_TOKEN}";
        proxy_set_header Host $host;
        # ⚠️ **No `X-Forwarded-For`.** §35 keeps IP addresses out of the system entirely, and adding the
        # header here would put one in `keep`'s reach for the sake of a convention.
        # ⚠⚠ **Resolved at request time, through a variable, rather than at start-up.** A literal
        # `proxy_pass http://keep:8081` makes nginx resolve `keep` while *reading* the config — so
        # **`serve` would refuse to start whenever the data layer is down**, which inverts §23: the game
        # is static and must survive the backend being absent. With a resolver and a variable, `keep`
        # being down is a 502 on two API paths and a working game everywhere else.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $keep_upstream keep;
        proxy_pass http://$keep_upstream:8081/$1;

        # A queue that retries is the client's design (C3); an edge that hangs on a slow data layer is
        # a page that hangs. `serve` answers, or it answers that it could not.
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    # ---- what must not answer ---------------------------------------------------------------------
    # ⚠️⚠️ **`/ui/phone/*.html` is not reachable** (v36-P3-48). Implementation paths are never exposed as
    # alternates: they are where the files happen to live today, and two URLs for one page is duplicate
    # content indexed permanently.
    #
    # ⚠️ It sits after `location /ui/` on purpose -- a regex location wins over a prefix one in nginx,
    # whatever the order in the file, and saying so here is cheaper than the next reader rediscovering
    # nginx's matching rules against a page that stopped loading.
    location ~ "^/ui/.*\.html$" {
        return 404;
    }

    # ⚠️⚠️ **`/p` and `/t/<mode>` are DEVELOPMENT routes and are deliberately absent.** `/t/<mode>`
    # reaches the board with a development mode; answering it in production hands a player
    # `?test=solved`. There is no rule here for either, and the test asserts their absence rather than
    # trusting it -- a route that is missing by accident and one that is missing on purpose look
    # identical from outside.
}
