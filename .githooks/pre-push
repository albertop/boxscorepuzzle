#!/bin/sh
# What branch protection would do, done on the laptop instead, because it cannot be done on the server.
#
# GitHub gates branch protection AND rulesets behind a paid plan for private repositories, and this
# repository is private permanently: `forge/` holds the generator and the human-solvability guarantee,
# which is trade secret. So `main` cannot be protected server-side, CI cannot be a required check, and
# CLAUDE.md now says so instead of claiming otherwise.
#
# This is the nearest available thing and it is deliberately NOT called protection:
#
#   - it runs on the laptop, so it protects against forgetting, not against intent
#   - `git push --no-verify` skips it entirely
#   - it cannot see what CI would find on another platform
#
# What it does is make "nothing pushed with a failing test or coverage under 95%" a check rather than
# a habit, on the one machine that exists. Enable it with:
#
#     git config core.hooksPath .githooks
#
set -e

# ⚠️⚠️ **The refs being pushed, read from stdin — not the branch that happens to be checked out.**
#
# Git hands a pre-push hook one line per ref on stdin: `<local ref> <local sha> <remote ref> <remote
# sha>`. This hook never read it. It asked `git rev-parse --abbrev-ref HEAD` and skipped whenever that
# was not `main`, which means it **failed open on every push to main not made from a main checkout**:
#
#   git push origin main          # from a feature branch
#   git push origin HEAD:main
#   git push origin <sha>:main    # or anything from a detached HEAD
#
# All three printed *"Skipping; CI is the check for a branch"* and pushed unchecked, to a remote with
# no branch protection. Those are forgetting-class paths, which is exactly the scope this hook claims:
# it guards against forgetting and not against intent. `--no-verify` is the documented way out and is
# untouched; this was a different hole, and a reassuring message on top of it. v36-P2-04.
push_to_main=0
while read -r _local _local_sha remote _remote_sha; do
  case "$remote" in
    refs/heads/main) push_to_main=1 ;;
  esac
done

if [ "$push_to_main" -eq 0 ]; then
  echo "pre-push: nothing headed for main. Skipping; CI is the check for a branch."
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root/forge"

echo "pre-push: a ref is headed for main. Running what CI runs, because main is not protected server-side."

echo "  ruff, forge"
uv run ruff check src scripts tests

echo "  ruff, discovery and tools, against the baseline"
# ⚠️⚠️ **Captured and printed on failure, not discarded.** (v36-P3-09) This sent everything to
# `/dev/null`, so a push aborted with **no indication of what to fix** — and the operator's next move
# after a silent refusal is `--no-verify`, which defeats the hook entirely. It also contradicted the
# ratchet's own recorded design: *the whole report is printed every run*. Quiet on success, complete on
# failure.
if ! ratchet=$(uv run python ../tools/lint_discovery.py); then
  echo "$ratchet"
  exit 1
fi

echo "  mypy"
uv run mypy src

echo "  tests and the coverage floor"
uv run pytest --cov --cov-report=term-missing -q

echo "  ruff format"
# ⚠️ `docs/python-conventions.md` mandates `ruff format` and neither this hook nor CI ran it, so the
# drift it exists to catch had reached `main`. v36-P3-01.
uv run ruff format --check src scripts tests

echo "  the browser suite"
uv run python ../tools/run_browser_tests.py

# ⚠️⚠️ **`keep` is a third tree and nothing here ran it until 2026-08-22.** A suite that is not executed
# protects nothing, and this one holds the retry contract the event record depends on.
#
# ⚠️ **Its Postgres arm fails rather than skips**, deliberately: without a database `PostgresStore` is
# 80% covered and the suite falls under its own floor while looking green. So the hook starts one if it
# is not already up. **A push that cannot reach Docker fails here rather than pushing untested code.**
cd "$root/keep"
echo "  keep: a postgres to test against"
if ! docker exec keep-test-pg pg_isready -q 2>/dev/null; then
  docker rm -f keep-test-pg >/dev/null 2>&1 || true
  docker run -d --name keep-test-pg -e POSTGRES_PASSWORD=keep -e POSTGRES_DB=keep     -p 55432:5432 postgres:17-alpine >/dev/null
  until docker exec keep-test-pg pg_isready -q 2>/dev/null; do sleep 1; done
fi

echo "  keep: ruff, mypy, and the contract suite on both engines"
uv run ruff check src tests
uv run ruff format --check src tests
uv run mypy src
KEEP_TEST_POSTGRES="postgresql://postgres:keep@localhost:55432/keep"   uv run pytest -q --cov --cov-report=term-missing

echo "pre-push: clean."
