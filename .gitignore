# Secrets
.env
.env.*
!.env.example

# Generated puzzle inventory — never enters Git, transferred to the VPS separately
forge/inventory/
# ⚠️ The reference batch's PRIVATE inventory, as of 2026-08-23. It holds all six signed packages and
# their dated pointers; `publish.rotate` publishes two of them into serve/data/puzzles, and those two
# ARE committed. Six in the deployed tree was the access model inverted -- two is what it allows.
forge/reference-inventory/

# Processed Retrosheet database and raw source files — rebuildable from the loader
forge/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# The hand-solve answer key. Committing it is harmless to the repository and fatal to the
# experiment — the fifty boards only measure anything if they are met blind.
discovery/hand-solve/key.csv
discovery/hand-solve/ceiling-key.csv
discovery/**/run.log

# The forge private key, if it is ever written inside the tree by accident. It belongs in the home
# directory and never in Git: a leaked signing key means anyone can sign inventory serve accepts.
*.signing-key
.boxscorepuzzle-signing-key

# Throwaway batches. Signed by a key that existed for one run, so they are worth nothing to keep
# and must never be mistaken for inventory.
discovery/ephemeral-puzzles/

# ⚠️ The reference writer's staging directory. The published packages under serve/data/puzzles/ ARE
# committed — they are the format sample serve is built against — but the staging area is transient and
# holds whatever a failed run left behind. It reached a commit once, from a run that discarded four of
# six boards and left the rest on disk.
serve/data/puzzles/.staging/

# The ceiling pack's erasure cache. Regenerable and large, and it is keyed to one sample.
discovery/hand-solve/ceiling-erasures.json
